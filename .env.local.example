# Configuration EmailJS — copiez ce fichier en `.env.local` et remplissez les valeurs
# (voir CONFIGURATION-EMAIL.md pour obtenir ces clés sur https://www.emailjs.com)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# URL publique du site (utilisée pour le SEO : sitemap, Open Graph…)
NEXT_PUBLIC_SITE_URL=https://amelie-portfolio.example.com
